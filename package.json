{
  "name": "residence-ops",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
