# Copiez ce fichier vers .env et remplissez les valeurs.
# Ne jamais committer le fichier .env réel (il est dans .gitignore).

PORT=3001

# Généré une fois pour signer les sessions (JWT). À garder secret.
# Générer une nouvelle valeur avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-real-secret

# Clés VAPID pour les notifications push (Web Push API).
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@residence-ops.fr

# Envoi d'email (mot de passe oublié, etc.).
# Laisser vide en développement : un compte de test Ethereal est créé
# automatiquement et les emails sont visibles via une URL de prévisualisation
# affichée dans les logs du serveur, sans configuration.
# En production, renseignez un vrai fournisseur SMTP (ex: SendGrid, Mailgun, OVH...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Résidence Ops" <no-reply@residence-ops.fr>

# Chemin du fichier de base de données SQLite (optionnel, défaut: server/src/db/data.sqlite)
DB_PATH=
