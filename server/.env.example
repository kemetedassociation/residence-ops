# Copiez ce fichier vers .env et remplissez les valeurs.
# Ne jamais committer le fichier .env réel (il est dans .gitignore).

PORT=3001

# Généré une fois pour signer les sessions (JWT). À garder secret.
# Générer une nouvelle valeur avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-real-secret

# Clés VAPID pour les notifications push (Web Push API).
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@residence-ops.fr

# Envoi d'email (mot de passe oublié, etc.).
# Laisser vide en développement : un compte de test Ethereal est créé
# automatiquement et les emails sont visibles via une URL de prévisualisation
# affichée dans les logs du serveur, sans configuration.
# En production, renseignez un vrai fournisseur SMTP (ex: SendGrid, Mailgun, OVH...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Résidence Ops" <no-reply@residence-ops.fr>

# Chemin du fichier de base de données SQLite (optionnel, défaut: server/src/db/data.sqlite)
DB_PATH=

# Sauvegarde automatique chiffrée vers un dépôt GitHub privé DÉDIÉ aux sauvegardes (jamais le
# dépôt de code source, qui peut être public). Inutile en développement local — laisser vide.
# BACKUP_ENCRYPTION_KEY : générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GITHUB_BACKUP_TOKEN : token GitHub à portée fine (fine-grained), limité à ce seul dépôt,
#   permission "Contents: Read and write".
# GITHUB_BACKUP_REPO : "compte/nom-du-depot" (ex: kemetedassociation/residence-ops-backups)
BACKUP_ENCRYPTION_KEY=
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=

# Usage réel : SEED_MODE=production crée uniquement une résidence + un gestionnaire (aucun compte de démo).
# SEED_MODE=production
# INITIAL_RESIDENCE_NAME=
# INITIAL_MANAGER_EMAIL=
# INITIAL_MANAGER_PASSWORD=   (12 caractères minimum)

# Paiement en ligne Stripe (recharge du porte-monnaie). Commencer par les clés de TEST (sk_test_...).
# STRIPE_WEBHOOK_SECRET : secret de signature (whsec_...) du webhook Stripe pointant vers /api/payments/webhook
# APP_URL : adresse publique du site (retour après paiement), ex. https://residence-ops.onrender.com
# STRIPE_MAX_TOPUP_EUR : plafond par recharge (défaut 200)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=
